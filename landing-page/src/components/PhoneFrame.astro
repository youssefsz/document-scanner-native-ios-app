---
import type { ImageMetadata } from "astro"
import { Image } from "astro:assets"

interface Props {
  src: ImageMetadata
  alt: string
  class?: string
  eager?: boolean
  sizes?: string
}

const {
  src,
  alt,
  class: className,
  eager = false,
  sizes = "(max-width: 640px) 58vw, 320px",
} = Astro.props
---

<div class:list={["phone-frame", className]}>
  <span class="phone-frame__side phone-frame__side--mute" aria-hidden="true"
  ></span>
  <span
    class="phone-frame__side phone-frame__side--volume-up"
    aria-hidden="true"></span>
  <span
    class="phone-frame__side phone-frame__side--volume-down"
    aria-hidden="true"></span>
  <span class="phone-frame__side phone-frame__side--power" aria-hidden="true"
  ></span>
  <div class="phone-frame__bezel">
    <span class="phone-frame__island" aria-hidden="true">
      <span class="phone-frame__camera"></span>
    </span>
    <Image
      class="phone-frame__screen"
      src={src}
      alt={alt}
      widths={[294, 471, 708]}
      sizes={sizes}
      format="webp"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={eager ? "high" : "auto"}
    />
  </div>
</div>
